# --- Unreal generated (rebuilt automatically) ---
/Binaries/
/Intermediate/
/Saved/
/DerivedDataCache/
/Plugins/**/Binaries/
/Plugins/**/Intermediate/

# --- Packaged builds (we'll output builds here in Week 6) ---
/Packaged/

# --- Visual Studio (regenerated via "Generate Visual Studio project files") ---
.vs/
*.sln
*.suo
*.sdf
*.opensdf
*.VC.db
*.VC.opendb
*.slnx

# --- Other IDEs ---
.idea/
.vscode/

# --- OS junk ---
Thumbs.db
Desktop.ini
.DS_Store
# --- Local secrets (EOS credentials). Template: Config/Windows/WindowsEngine.ini.example ---
/Config/Windows/WindowsEngine.ini

# --- Packaged builds ---
/Build/

# --- Python bytecode from editor scripts ---
__pycache__/
*.pyc
