; Online play (room codes) through Epic Online Services.
; Copy this file to WindowsEngine.ini in this folder (that file is gitignored, so the values never reach GitHub)
; and paste the five values from the Epic Developer Portal (Docs/EOS_SETUP.md).
; Without the file, the game is direct IP only. Packaged Windows builds include the file.

[EOSSDK.Platform.KartArena]
ProductId=PASTE_PRODUCT_ID
SandboxId=PASTE_SANDBOX_ID
DeploymentId=PASTE_DEPLOYMENT_ID
ClientId=PASTE_CLIENT_ID
ClientSecret=PASTE_CLIENT_SECRET
